; Fichier de configuration du projet Godot (ne pas modifier à la main sauf besoin)

config_version=5

[application]

config/name="Jeu spatial"
config/description="Simulateur spatial réaliste — phase 1 : physique de vol"
run/main_scene="res://scenes/jeu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
